# Armara Vision — environment configuration
# Copy to .env and fill in. Every key is optional: the app degrades to cached
# snapshot data whenever a provider key is missing or a provider is down.

# --- Database ---------------------------------------------------------------
# SQLite (default, zero-config). For Postgres, also change the provider in
# prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Token market data ------------------------------------------------------
# CoinGecko: works keyless on the free tier (rate-limited ~10-30 req/min).
# Pro key (https://www.coingecko.com/en/api/pricing) switches the client to
# pro-api.coingecko.com automatically.
COINGECKO_API_KEY=""

# GeckoTerminal (DEX pools/liquidity): public API, no key required.

# DefiLlama (issuer TVL): public API, no key required.

# --- Underlying equity prices -----------------------------------------------
# Finnhub free tier: 60 calls/min. Get a key at https://finnhub.io/register
# Without a key, premium/discount falls back to the last stored snapshot.
FINNHUB_API_KEY=""

# --- Stubs (not yet wired) --------------------------------------------------
# rwa.xyz institutional API is request-only: https://www.rwa.xyz (contact)
RWA_XYZ_API_KEY=""
# Dune API for holder concentration / whale transfers: https://dune.com/settings/api
DUNE_API_KEY=""

# --- Cron -------------------------------------------------------------------
# Shared secret for /api/cron/snapshot (sent as "Authorization: Bearer ...").
# Leave empty to allow unauthenticated calls in local dev.
CRON_SECRET=""
