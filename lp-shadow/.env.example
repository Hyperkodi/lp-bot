# --- lp-shadow Phase 1 -------------------------------------------------------
# Read-only shadow mode. There is deliberately NO private key, keypair path, or
# mnemonic variable here — Phase 1 never signs or sends a transaction.

# Postgres connection string for the ledger.
DATABASE_URL="postgresql://lpshadow:lpshadow@localhost:5432/lpshadow?schema=public"

# Solana RPC. Helius is recommended because the priority-fee estimator
# (getPriorityFeeEstimate) is served from the same URL; any RPC works, the
# poller falls back to getRecentPrioritizationFees when the method is absent.
RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_KEY"

# Telegram reporting. Leave TELEGRAM_BOT_TOKEN empty to disable reporting
# entirely (the loop still runs and persists everything).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional. Jupiter's keyed host (https://api.jup.ag) is used when a key is
# present; otherwise the free host (https://lite-api.jup.ag) is used.
JUPITER_API_KEY=""

# Optional override for the config file path.
# LP_SHADOW_CONFIG="./config/default.toml"
